# ============================================
# SCANYX - Nmap Scanner Framework
# Git Ignore Configuration
# ============================================

# Nmap scan results
nmap/

# Scan output directories. The default is nmap/, but -OutputDir takes any path
# and these fill up with .nmap/.xml/.gnmap plus .sessions/ state and logs.
# Underscore-prefixed ones are the throwaway directories used while testing.
_*/
scan-results.json
scan-results.jsonl
scan-state.json
scan-state_*.json
scan.log
scan-errors.log

# PowerShell temporary files
*.tmp
*.temp

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Backup files (if any are created in the future)
*.backup
*.bak
*.old

# WIKI draft
WIKI.md

# Tests
.github/